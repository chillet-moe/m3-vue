{
  "name": "@chillet/m3-vue",
  "version": "0.33.0",
  "repository": {
    "url": "git+https://github.com/chillet-moe/m3-vue.git"
  },
  "files": [
    "dist",
    "web-types.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/guides",
    "docs/components",
    "docs/directives",
    "docs/functions",
    "docs/utilities",
    "docs/demos"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/state-layer.ts",
    "**/index.ts"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./docs": "./docs/README.md",
    "./docs/*": "./docs/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs"
    },
    "./style.css": "./dist/style.css",
    "./typography-classes.css": "./dist/typography-classes.css",
    "./color-classes.css": "./dist/color-classes.css",
    "./typography.module.css": "./dist/typography.module.css",
    "./colors.module.css": "./dist/colors.module.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "vp config",
    "build": "vp build",
    "build:types": "vue-tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "prepublishOnly": "pnpm run build && pnpm run build:types",
    "test": "vp test run",
    "typecheck": "vue-tsc -b",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "remove-unused-vars": "tsx scripts/remove-unused-vars/index.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@chillet/vue-scope-boundary": "^0.1.0",
    "@chillet/postcss-custom-mixins": "^0.2.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/compiler-core": "^3.5.39",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/tsconfig": "^0.9.1",
    "@yuheiy/postcss-custom-functions": "^0.1.1",
    "browserslist": "^4.28.2",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "jsdom": "27.4.0",
    "lightningcss": "^1.32.0",
    "oxc-minify": "^0.124.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.16",
    "shiki": "4.0.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "4.1.9",
    "vue-component-meta": "^3.2.7",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.86.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.2",
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "web-types": "./web-types.json"
}
