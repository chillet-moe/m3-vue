{
  "name": "@chillet/m3-vue",
  "version": "0.1.12",
  "type": "module",
  "repository": {
    "url": "git+https://github.com/chillet-moe/m3-vue.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/index.css"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "web-types.json"
  ],
  "sideEffects": [
    "**/*.css",
    "**/state-layer.ts"
  ],
  "web-types": "./web-types.json",
  "scripts": {
    "build": "vite build",
    "build:types": "vue-tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "prepublishOnly": "pnpm run build && pnpm run build:types",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@chillet/postcss-custom-mixins": "^0.2.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@yuheiy/postcss-custom-functions": "^0.1.1",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.0",
    "histoire": "1.0.0-beta.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "tsc-alias": "^1.8.16",
    "tsdown": "0.20.0-beta.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-component-meta": "^3.2.2",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.58.0",
    "storybook": "^10.1.11",
    "@storybook/vue3-vite": "^10.1.11",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "vitest": "^4.0.17",
    "playwright": "^1.57.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
