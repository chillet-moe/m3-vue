{
  "name": "@chillet/m3-vue",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "url": "https://github.com/chillet-moe/m3-vue"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "src/components"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@chillet/postcss-custom-mixins": "^0.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@yuheiy/postcss-custom-functions": "^0.1.1",
    "histoire": "1.0.0-beta.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "tsdown": "0.20.0-beta.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.58.0"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
