{
  "name": "@chillet/m3-vue",
  "version": "0.50.1",
  "repository": {
    "url": "git+https://github.com/chillet-moe/m3-vue.git"
  },
  "files": [
    "dist",
    "web-types.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/guides",
    "docs/zh-Hans",
    "docs/components",
    "docs/directives",
    "docs/functions",
    "docs/utilities",
    "docs/demos"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/state-layer.ts",
    "**/index.ts"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./docs": "./docs/README.md",
    "./docs/*": "./docs/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.mjs"
    },
    "./locales/zh-Hans": {
      "types": "./dist/locales/zh-Hans.d.ts",
      "import": "./dist/locales/zh-Hans.mjs"
    },
    "./locales/zh-Hant": {
      "types": "./dist/locales/zh-Hant.d.ts",
      "import": "./dist/locales/zh-Hant.mjs"
    },
    "./style.css": "./dist/style.css",
    "./typography-classes.css": "./dist/typography-classes.css",
    "./color-classes.css": "./dist/color-classes.css",
    "./typography.module.css": "./dist/typography.module.css",
    "./colors.module.css": "./dist/colors.module.css",
    "./themes/default.css": "./dist/themes/default.css",
    "./themes/compact.css": "./dist/themes/compact.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run themes:generate && vite build && pnpm run build:types",
    "build:types": "vue-tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:browser": "tsx tests/browser/run.ts",
    "typecheck": "vue-tsc -b",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "remove-unused-vars": "tsx scripts/remove-unused-vars/index.ts",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run docs:check",
    "docs:check": "node scripts/check-docs.mjs",
    "themes:generate": "node --import tsx scripts/generate-themes.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@chillet/postcss-custom-mixins": "^0.3.0",
    "@chillet/vue-scope-boundary": "^0.2.0",
    "@emnapi/core": "^1.11.3",
    "@nuxt/kit": "^4.4.2",
    "@tanstack/vue-virtual": "^3.13.48",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "catalog:",
    "@vue/compiler-core": "^3.5.39",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/tsconfig": "^0.9.1",
    "@yuheiy/postcss-custom-functions": "^0.1.1",
    "browserslist": "^4.28.2",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "jsdom": "27.4.0",
    "lightningcss": "^1.32.0",
    "material-symbols": "0.48.1",
    "oxc-minify": "^0.124.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.16",
    "shiki": "4.0.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "catalog:",
    "vue-component-meta": "^3.2.7",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.86.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.4.2",
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "web-types": "./web-types.json"
}
