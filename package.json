{
  "name": "@chillet/m3-vue",
  "version": "0.13.1",
  "repository": {
    "url": "git+https://github.com/chillet-moe/m3-vue.git"
  },
  "files": [
    "dist",
    "web-types.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/state-layer.ts",
    "**/index.ts"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs"
    },
    "./style.css": "./dist/style.css",
    "./typography-classes.css": "./dist/typography-classes.css",
    "./color-classes.css": "./dist/color-classes.css",
    "./typography.module.css": "./dist/typography.module.css",
    "./colors.module.css": "./dist/colors.module.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "build:types": "vue-tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "prepublishOnly": "pnpm run build && pnpm run build:types",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "story:dev": "storybook dev -p 6006 --no-open",
    "story:build": "storybook build",
    "story:preview": "vite preview --host --outDir=storybook-static",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "@vueuse/core": "^14.2.1",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@chillet/postcss-custom-mixins": "^0.2.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/vue3-vite": "^10.3.5",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/tsconfig": "^0.9.1",
    "@vueless/storybook-dark-mode": "^10.0.7",
    "@yuheiy/postcss-custom-functions": "^0.1.1",
    "browserslist": "^4.28.2",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "lightningcss": "^1.32.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "storybook": "^10.3.5",
    "tsc-alias": "^1.8.16",
    "tsdown": "0.21.7",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.8",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.4",
    "vue-component-meta": "^3.2.6",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.81.1"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "web-types": "./web-types.json"
}
