{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@chillet/m3-vue": ["./src/index.ts"],
      "@chillet/m3-vue/theme": ["./src/theme/colors.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "env.d.ts",
    "docs/.vitepress/env.d.ts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.vue",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "docs/**/*.vue"
  ],
  "exclude": ["src/**/*.stories.ts", "src/**/*.test.ts"]
}
