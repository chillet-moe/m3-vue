{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "m3-vue",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./.histoire/dist",
    "binding": "ASSETS"
  },
  "preview_urls": true,
  "build": {
    "command": "pnpm run story:build"
  }
}
