{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "m3-vue",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true,
  "build": {
    "command": "pnpm run docs:build"
  }
}
